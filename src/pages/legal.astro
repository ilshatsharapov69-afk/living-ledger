---
/**
 * The small print. One route, three anchors, deliberately not three thin pages.
 *
 * WHAT THIS IS AND IS NOT
 *
 * Boilerplate with the firm's name and state templated in, written to be
 * readable rather than to be long. It exists because a real firm cannot go live
 * without it and because the footer links to it — a footer with dead legal
 * links is worse than a footer without them.
 *
 * It is NOT legal advice and it is not a substitute for the buyer's attorney
 * reading it. RESKIN.md says so in the handover, and so does the page.
 *
 * One thing half the surveyed firms get wrong and this does not: the GLBA
 * privacy notice a financial firm delivers TO ITS CLIENTS is a different
 * document from a website privacy policy. Conflating them means neither job is
 * done. This is the website one.
 *
 * There is no accessibility "certificate" here, and there must never be. There
 * is no DOJ standard for a private business, so "compliant" is unprovable — and
 * the FTC took $1m off accessiBe in 2025 over exactly that kind of claim. What
 * is written instead is what was actually done.
 */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Foot from '../components/Foot.astro';
import { firm } from '../config/firm';
import { legal } from '../config/content';
import { href } from '../lib/url';
---

<Base title={`${firm.name} — the small print`} description={legal.intro} theme="light">
  <Masthead />

  <main class="lg">
    <div class="lg__frame frame">
      <header class="lg__head">
        <p class="lg__eyebrow u-caps">{legal.eyebrow}</p>
        <h1 class="lg__title">{legal.heading}</h1>
        <p class="lg__intro">{legal.intro}</p>
        <p class="lg__updated">{legal.updated}</p>
      </header>

      <nav class="lg__toc" aria-label="Sections">
        {legal.sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
      </nav>

      {
        legal.sections.map((s) => (
          <section class="lg__sec sheet sheet--fibre" data-stock="bond" id={s.id}>
            <h2 class="lg__sec-title">{s.title}</h2>
            {s.body.map((p) => (
              <p class="lg__p">{p}</p>
            ))}
          </section>
        ))
      }

      <p class="lg__back"><a href={href('/')}>← {legal.back}</a></p>
    </div>
  </main>

  <Foot />
</Base>

<style>
  .lg {
    position: relative;
    z-index: 1;
    padding-block: calc(var(--mast-h) + clamp(3rem, 9vh, 6rem)) clamp(2rem, 6vh, 4rem);
  }

  .lg__frame {
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
    max-width: 58rem;
  }

  .lg__eyebrow {
    font-size: var(--fs-2xs);
    color: var(--brand-lit);
  }

  .lg__title {
    margin-top: 0.4rem;
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.028em;
    color: var(--desk-ink);
  }

  .lg__intro {
    margin-top: 0.75rem;
    max-width: 62ch;
    font-size: var(--fs-base);
    line-height: 1.55;
    color: var(--desk-ink-quiet);
    text-wrap: pretty;
  }

  .lg__updated {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--desk-mark);
  }

  .lg__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
  }

  .lg__toc a {
    font-size: var(--fs-sm);
    color: var(--desk-ink);
    border-bottom: 1px solid var(--desk-mark);
  }

  .lg__toc a:hover {
    color: var(--brand-lit);
    border-bottom-color: var(--brand-lit);
  }

  .lg__sec {
    padding: clamp(1.25rem, 3vw, 2rem);
    scroll-margin-top: calc(var(--mast-h) + 1.5rem);
    box-shadow: var(--shadow-rest);
  }

  .lg__sec-title {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--paper-ink);
  }

  .lg__p {
    margin-top: 0.8rem;
    max-width: 70ch;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--paper-ink);
    text-wrap: pretty;
  }

  .lg__back a {
    font-size: var(--fs-sm);
    color: var(--desk-ink-quiet);
    border-bottom: 1px solid transparent;
  }

  .lg__back a:hover {
    color: var(--desk-ink);
    border-bottom-color: var(--desk-mark);
  }
</style>
