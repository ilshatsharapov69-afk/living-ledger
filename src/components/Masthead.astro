---
/**
 * The header is not a nav bar. It is a strip of the firm's letterhead lying on
 * the desk — inset from the edges, printed in paper ink, casting a shadow, and
 * ruled along the bottom in the brand colour the way a real letterhead is. That
 * rule is also the rescin trick: any logo, of any colour, lands on white paper
 * over a coloured line, and the whole strip re-brands from one hex.
 *
 * It carries three of the six questions the first screen has to answer before
 * the visitor reads a word of the headline: who this is (name), what they do and
 * where (descriptor), and how to reach a person (phone, with a line telling you
 * what happens if you call). The report is specific that a bare number in a
 * header gets ignored and a number with a promise over it does not.
 *
 * It condenses once the visitor has moved past the first screen (`data-past` is
 * set by the scroll engine).
 */
import FirmMark from './FirmMark.astro';
import Social from './Social.astro';
import { firm } from '../config/firm';
import { href } from '../lib/url';
---

<header class="masthead">
  <div class="masthead__sheet sheet">
    <a class="masthead__id" href={href('/')}>
      <FirmMark />
      <span class="masthead__lockup">
        {!firm.logo.includesName && <span class="masthead__name">{firm.name}</span>}
        <span class="masthead__descriptor">{firm.descriptor}</span>
      </span>
    </a>

    <nav class="masthead__nav" aria-label="Sections">
      {
        firm.nav.map((item) => (
          <a class="masthead__link" href={href(item.href)}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="masthead__act">
      <Social size="mark" class="masthead__social" />

      <a class="masthead__phone" href={firm.contact.phoneHref}>
        <svg class="masthead__handset" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M7.4 3.2c.5-.1 1 .16 1.22.62l1.5 3.1c.2.42.11.92-.22 1.24l-1.2 1.17a.6.6 0 0 0-.12.7 12.3 12.3 0 0 0 5.4 5.32.6.6 0 0 0 .7-.12l1.2-1.2c.32-.32.82-.4 1.23-.2l3.1 1.53c.46.23.7.74.58 1.24l-.5 2.1a1.3 1.3 0 0 1-1.27 1c-8.2 0-14.85-6.6-14.85-14.75 0-.6.42-1.13 1.01-1.27l2.22-.48Z"
          />
        </svg>
        <span class="masthead__phone-num u-num">{firm.contact.phone}</span>
      </a>
      {
        /* Only if they actually have a portal. A dead "Client login" is the
           most damaging kind of placeholder: it is the most-clicked link on a
           real firm's site, so it is the one a visitor tries first. */
        firm.contact.clientLoginUrl && (
          <a class="masthead__login" href={firm.contact.clientLoginUrl}>
            {firm.cta.login}
          </a>
        )
      }
      <a class="masthead__cta" href={href(firm.contact.calendarUrl)}>{firm.cta.primary}</a>
    </div>
  </div>
</header>

<style>
  /* Fixed, not sticky: every scene below is pinned with `position: sticky`, and
     a sticky header would eat a slice of each scene's own scroll budget. */
  .masthead {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    padding: clamp(0.5rem, 0.9vw, 0.875rem) var(--gutter) 0;
    pointer-events: none;
  }

  .masthead__sheet {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--s-5);
    max-width: var(--frame);
    margin-inline: auto;
    padding: 0.55rem clamp(0.75rem, 1.4vw, 1.25rem) 0.6rem;
    transition:
      padding var(--t-base) var(--ease-paper),
      box-shadow var(--t-base) var(--ease-paper);
  }

  /* The ruled foot of a letterhead. Two lines, the way it is actually printed:
     a heavy brand rule with a hairline under it. */
  .masthead__sheet::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    border-radius: 0 0 var(--sheet-radius) var(--sheet-radius);
    background: linear-gradient(
      var(--brand-solid) 0 2px,
      color-mix(in oklab, var(--brand-solid) 34%, transparent) 2px 3px
    );
  }

  :global(html[data-past='true']) .masthead__sheet {
    padding-block: 0.4rem 0.45rem;
    box-shadow: var(--shadow-lift);
  }

  .masthead__id {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: none;
  }

  .masthead__lockup {
    display: grid;
    gap: 0.1rem;
  }

  .masthead__name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--paper-ink);
    white-space: nowrap;
  }

  /* Where am I. Set in the same ink as the name, one size down — a grey
     sub-line reads as boilerplate and gets skipped. */
  .masthead__descriptor {
    font-size: 0.9375rem;
    line-height: 1.2;
    letter-spacing: -0.008em;
    color: var(--paper-ink-quiet);
    white-space: nowrap;
  }

  /* Condensed state: the descriptor has been read, the name is enough. */
  :global(html[data-past='true']) .masthead__descriptor {
    display: none;
  }

  .masthead__nav {
    display: flex;
    gap: clamp(0.6rem, 1.15vw, 1.25rem);
    margin-inline-start: auto;
  }

  /* The strip now carries a lockup, four sections, three icons, a number and a
     button. Without this a nav item wraps to two lines and the whole letterhead
     grows a second row — which it did the moment the icons went in. */
  .masthead__link {
    white-space: nowrap;
    font-size: 1rem;
    letter-spacing: -0.011em;
    color: var(--paper-ink-quiet);
    padding-block: 0.15rem;
    border-bottom: 1px solid transparent;
    transition:
      color var(--t-fast),
      border-color var(--t-fast);
  }

  .masthead__link:hover {
    color: var(--paper-ink);
    border-bottom-color: var(--brand-ink);
  }

  .masthead__act {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 1.1vw, 1rem);
    flex: none;
  }

  /*
   * Answers the sixth question of the first screen — how do I reach a person —
   * without waiting for the footer.
   *
   * There used to be a line of grey uppercase mono over it saying what happens
   * if you call. It was the right idea and the wrong object: at 12px in a quiet
   * ink it read as noise stacked on the one fact anybody wanted, and it made
   * the number look like a caption. The promise it carried now lives under the
   * hero button, which is where somebody is actually deciding. The number gets
   * to be a number: a handset, an ink that is not grey, and enough weight to be
   * read across the room.
   */
  .masthead__phone {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    color: var(--paper-ink);
    transition: color var(--t-fast);
  }

  .masthead__phone:hover {
    color: var(--brand-ink);
  }

  .masthead__handset {
    width: 0.9375rem;
    height: 0.9375rem;
    flex: none;
    color: var(--brand-ink);
  }

  .masthead__phone-num {
    font-size: 1.1875rem;
    font-weight: 580;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  /* Hairline between "look us up" and "call us". Without it the icons read as
     part of the number. */
  .masthead__social {
    position: relative;
    padding-right: clamp(0.6rem, 1.1vw, 1rem);
  }

  .masthead__social::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    height: 1.4rem;
    width: 1px;
    background: var(--paper-rule);
    translate: 0 -50%;
  }

  .masthead__login {
    font-size: 1.0625rem;
    letter-spacing: -0.011em;
    color: var(--paper-ink-quiet);
    white-space: nowrap;
    transition: color var(--t-fast);
  }

  .masthead__login:hover {
    color: var(--paper-ink);
  }

  /* A tab you'd stick on a folder: square where it meets the edge, rounded out. */
  .masthead__cta {
    font-size: 1.0625rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    white-space: nowrap;
    padding: 0.6rem 1.15rem;
    color: var(--brand-on-solid);
    background: var(--brand-solid);
    border-radius: 2px 10px 10px 2px;
    box-shadow: var(--shadow-flat);
    transition:
      translate var(--t-fast) var(--ease-snap),
      box-shadow var(--t-fast) var(--ease-snap);
  }

  .masthead__cta:hover {
    translate: 0 -1px;
    box-shadow: var(--shadow-rest);
  }

  .masthead__cta:active {
    translate: 0 1px;
    box-shadow: none;
  }

  @media (max-width: 1380px) {
    .masthead__nav {
      gap: 1rem;
    }
  }

  @media (max-width: 1180px) {
    .masthead__nav {
      display: none;
    }
    .masthead__act {
      margin-inline-start: auto;
    }
  }

  /* The icons are the first thing to go: they are a lookup, and the number and
     the button are the two things somebody actually does from here. They go
     before the nav does, because a nav that has lost two items is worse than
     no icons. */
  @media (max-width: 1300px) {
    .masthead__social {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .masthead__descriptor,
    .masthead__login {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .masthead__handset {
      width: 0.8125rem;
      height: 0.8125rem;
    }
    .masthead__phone-num {
      font-size: var(--fs-sm);
    }
    .masthead__sheet {
      gap: 0.6rem;
      padding-inline: 0.7rem;
    }
    .masthead__cta {
      padding: 0.5rem 0.8rem;
      font-size: var(--fs-xs);
    }
  }

  @media (max-width: 400px) {
    .masthead__phone {
      display: none;
    }
  }
</style>
