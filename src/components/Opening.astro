  }

  /* ── short viewports ──────────────────────────────────────────────── */

  /*
   * Height, not width, is what this scene runs out of first: the clearing, the
   * heading band and the paper are competing for the same vertical inches, and
   * a 700-tall laptop has 200 fewer of them than the 900 everything is drawn
   * for. Corrected with the two knobs rather than by moving sheets.
   */
  @media (min-width: 901px) and (max-height: 810px) {
    .slot {
      --msk: 0.84;
    }

    .say__cue {
      display: none;
    }

    .say__promise {
      margin-top: 0.75rem;
    }

  }

  @media (max-width: 900px) and (max-height: 790px) {
    .slot {
      --msk: 0.88;
    }

    /* No room for a top band and a headline both. The bottom keeps the ring. */
    .opening__copy {
      padding-top: clamp(0.5rem, 2.5vh, 1.5rem);
    }

    .slot--card,
    .slot--jobcost {
      display: none;
    }

    .say__line-a {
      font-size: clamp(1.6875rem, 1.1rem + 2.9vw, 2.375rem);
    }

