  }

  /*
   * Without motion the scene still has to say the same thing, so it presents its
   * resolved state rather than an unexplained pile.
   */
  @media (prefers-reduced-motion: reduce) {
    .float,
    .say__cue-rule {
      animation: none;
    }

    .say__arrow path {
      stroke-dashoffset: 0;
