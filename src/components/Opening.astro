  /* ── narrow ───────────────────────────────────────────────────────── */

  /*
   * Phone and small tablet. The ring rotates through ninety degrees.
   *
   * On a portrait screen the edges that have room are the top and the bottom,
   * so that is where the paper goes: a band of it cropped under the letterhead,
   * and a bank of it below the copy. Paper down the SIDES was tried and
   * measured, and it does not survive contact with a 390px screen — a headline
   * that leaves 40px of margin either side is a headline nobody reads, and
   * 40px of paper reads as a rendering bug rather than a desk. Better an honest
   * two-sided crop than a four-sided one that ruins the sentence it frames.
   *
   * The copy is pushed down to make the top band, which is also why the whole
   * arrangement collapses back to bottom-only on a short phone: there, the
   * inches genuinely are not there.
   */
  @media (max-width: 900px) {
    .opening {
      --run: 132;
    }

    /* Top-aligned, so the padding is a real offset that opens the top band
       rather than half an offset shared with the bottom. */
    .opening__copy {
      place-items: start center;
      padding-top: clamp(4.5rem, 13vh, 7.5rem);
      padding-bottom: 0;
    }

    .say--hero {
      max-width: min(32rem, 92vw);
    }

    .say__promise {
      max-width: 30ch;
    }

    .say__cue {
      display: none;
    }

    /* The top band: paper under the letterhead, cropped on two edges. */
    .slot--card {
      --w: 46;
      --wh: 23;
      --cx: -42;
      --cy: -45;
      --crot: 4;
      --mx: -60;
      --my: -74;
      --mrot: 12;
      --tx: -60;
      --ty: -74;
    }

    .slot--jobcost {
      --w: 48;
      --wh: 24;
      --cx: 40;
      --cy: -47;
      --crot: 10;
      --mx: 56;
      --my: -78;
      --mrot: 18;
      --tx: 56;
      --ty: -78;
    }

    /* The bank along the bottom. */
    .slot--receipts {
      --w: 44;
      --wh: 22;
      --cx: -48;
      --cy: 30;
      --crot: -6;
      --mx: -84;
      --my: 62;
      --mrot: -14;
