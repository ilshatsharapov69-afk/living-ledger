       marks point into them, and a mark cannot be drawn at a sheet that is not
       there yet without ending on bare desk. */
    --d1: 0.135;
    --dur1: 0.15;
    --d2: 0.44;
    --dur2: 0.16;
    --wob: -1.2;
    --depth: 22;
    --tilt: 1.3;
    --gustr: 1.7;
    --wx: var(--ptr-x2);
