    /* No empty corner on a portrait screen — the paper band runs the full
       width of the foot. The slug goes back under the tally, and the tally
       lifts by exactly one line of it so the two cannot meet. */
    .opening__pin {
      --foot: clamp(0.75rem, 3vh, 1.75rem);
      --tally-lift: 1.25rem;
    }

