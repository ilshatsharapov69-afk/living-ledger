---
/**
 * The firm's other addresses.
 *
 * A visitor who has never heard of this bookkeeper is about to be asked for
 * read-only access to his bank feed. Before that happens he wants to look them
 * up — and the whole value of putting the marks in the letterhead is that the
 * lookup takes one click instead of a search that might not find them.
 *
 * Nothing renders for a platform the firm is not on. There is no greyed-out
 * placeholder and no link to a profile that does not exist: an empty social row
 * is the loudest possible "this is a template".
 *
 * The marks are drawn here rather than fetched. Every icon set on npm is either
 * a font (a network request and a flash of nothing) or a component library
 * (a framework this site does not have), and both would break the rule the rest
 * of the page keeps — nothing is loaded from anybody else's server.
 */
import { firm } from '../config/firm';

interface Props {
  /** `mark` is the header row; `plate` is the larger footer treatment. */
  size?: 'mark' | 'plate';
  class?: string;
}

const { size = 'mark', class: klass = '' } = Astro.props;

/*
 * Order is deliberate: the two a small US firm is most likely to actually have
 * come first, so a firm with only one profile still gets a sensible row.
 */
const links = [
  { id: 'facebook', label: 'Facebook', href: firm.social.facebook },
  { id: 'instagram', label: 'Instagram', href: firm.social.instagram },
  { id: 'linkedin', label: 'LinkedIn', href: firm.social.linkedin },
  { id: 'google', label: 'Google Business Profile', href: firm.social.google },
  { id: 'whatsapp', label: 'WhatsApp', href: firm.social.whatsapp },
].filter((l): l is { id: string; label: string; href: string } => Boolean(l.href));

/*
 * Instagram's ramp is an SVG paint server, and a paint server is addressed by
 * id. This component renders twice on a page — letterhead and foot — so a fixed
 * id would leave the second row quietly painting out of the first row's defs.
 * That works right up until somebody changes one of them, which is the worst
 * kind of bug. A per-render suffix costs a line and removes the whole class.
 */
const ramp = `ig-ramp-${Math.random().toString(36).slice(2, 9)}`;
---

{
  links.length > 0 && (
    <ul class:list={['social', `social--${size}`, klass]}>
      {links.map((l) => (
        <li>
          <a
            class="social__link"
            data-net={l.id}
            href={l.href}
            title={l.label}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="u-hidden">{l.label}</span>
            <svg class="social__glyph" viewBox="0 0 24 24" aria-hidden="true">
              {l.id === 'facebook' && (
                <path
                  fill="currentColor"
                  d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"
                />
              )}

              {/* The only mark of the five that is drawn as an outline in the
                  wild. Stroke width is tuned by eye against the solid glyphs
                  beside it — matching the number, not the weight, reads thin.

                  Its colour is a ramp rather than a flat hex, so it cannot come
                  from `currentColor`. The units are `userSpaceOnUse` and not the
                  default bounding box, which is the whole trick: on the default
                  every shape gets its own copy of the ramp and the 2px shutter
                  dot would carry the entire rainbow. Anchored to the viewBox,
                  the three shapes share one diagonal — yellow in the bottom-left
                  corner, violet at the shutter — which is how the real mark
                  runs. */}
              {l.id === 'instagram' && (
                <Fragment>
                  <defs>
                    <linearGradient
                      id={ramp}
                      gradientUnits="userSpaceOnUse"
                      x1="4"
                      y1="20.5"
                      x2="20"
                      y2="3.5"
                    >
                      <stop offset="0" stop-color="#feda75" />
                      <stop offset="0.18" stop-color="#fa7e1e" />
                      <stop offset="0.46" stop-color="#d62976" />
                      <stop offset="0.74" stop-color="#962fbf" />
                      <stop offset="1" stop-color="#4f5bd5" />
                    </linearGradient>
                  </defs>
                  <g fill="none" stroke={`url(#${ramp})`} stroke-width="1.9">
                    <rect x="3" y="3" width="18" height="18" rx="5.2" />
                    <circle cx="12" cy="12" r="4.1" />
                    <circle cx="17.1" cy="6.9" r="1.15" fill={`url(#${ramp})`} stroke="none" />
                  </g>
                </Fragment>
              )}

              {l.id === 'linkedin' && (
                <path
                  fill="currentColor"
                  d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3.1 9.15h3.76V21H3.1V9.15Zm6.13 0h3.6v1.62h.05c.5-.95 1.73-1.95 3.56-1.95 3.8 0 4.5 2.5 4.5 5.76V21h-3.75v-5.55c0-1.32-.02-3.03-1.85-3.03-1.85 0-2.13 1.45-2.13 2.94V21H9.23V9.15Z"
                />
              )}

              {/* Their Google Business profile. Drawn as a map pin, not as the
                  four-colour G: the G is Google's logo and this link is the
                  firm's own listing, so a pin is both the honest object and the
                  one that survives being printed in a single ink. */}
              {l.id === 'google' && (
                <path
                  fill="currentColor"
                  d="M12 2.2c-3.7 0-6.7 2.94-6.7 6.57 0 4.83 6.03 12.4 6.29 12.72a.53.53 0 0 0 .82 0c.26-.32 6.29-7.89 6.29-12.72 0-3.63-3-6.57-6.7-6.57Zm0 9.63a3.02 3.02 0 0 1-3.05-2.99A3.02 3.02 0 0 1 12 5.85a3.02 3.02 0 0 1 3.05 2.99A3.02 3.02 0 0 1 12 11.83Z"
                />
              )}

              {l.id === 'whatsapp' && (
                <path
                  fill="currentColor"
                  d="M12.04 2.4a9.5 9.5 0 0 0-8.1 14.42L2.5 21.9l5.2-1.37A9.5 9.5 0 1 0 12.04 2.4Zm0 1.72a7.78 7.78 0 0 1 6.6 11.9 7.78 7.78 0 0 1-9.99 2.87l-.36-.17-3.08.81.82-3-.18-.37a7.78 7.78 0 0 1 6.19-12.04Zm-3.3 3.9c-.16.01-.42.06-.64.3-.22.24-.85.83-.85 2.02 0 1.2.87 2.35.99 2.51.12.16 1.7 2.7 4.19 3.68 2.07.81 2.5.65 2.95.61.45-.04 1.45-.59 1.66-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28-.24-.12-1.45-.72-1.68-.8-.22-.08-.38-.12-.54.12-.16.24-.62.8-.76.96-.14.16-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.45-1.35-1.69-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.33-.74-1.82-.2-.47-.4-.41-.54-.42h-.46Z"
                />
              )}
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* A key on the letterhead: hairline box, paper under it, ink on top. It reads
     as pressed into the sheet rather than dropped on it. */
  .social__link {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 3px;
    color: var(--net);
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      color var(--t-fast),
      background-color var(--t-fast),
      box-shadow var(--t-fast);
  }

  /*
   * THE ONLY BRAND COLOURS ON THIS SITE THAT ARE NOT DERIVED, and they are not
   * derived because they are not ours to derive. Every other colour on the page
   * comes out of one hex in firm.ts and is contrast-checked at build time; a
   * mark belonging to somebody else does not get re-tinted to match
   * the firm's letterhead, and a monochrome Instagram glyph is a monochrome
   * Instagram glyph — it is recognised a beat slower than the real one, and a
   * beat is the entire budget this row has.
   *
   * Two variables, because rest and hover are different questions:
   *   --net     the mark's own ink at rest
   *   --net-hi  what the plate lights up with — the mark's colour if it has one,
   *             the firm's brand ink if it does not, so the Google pin keeps the
   *             hover it has always had.
   *
   * The pin is the one mark left in ink on purpose. It is the firm's own listing
   * drawn as a pin rather than Google's four-colour G — see the note by the path
   * — so there is no brand colour there to borrow.
   */
  .social__link {
    --net: var(--paper-ink-quiet);
    --net-hi: var(--brand-ink);
  }

  .social__link[data-net='facebook'] {
    --net: #1877f2;
    --net-hi: #1877f2;
  }

  .social__link[data-net='linkedin'] {
    --net: #0a66c2;
    --net-hi: #0a66c2;
  }

  /* Instagram paints itself from the gradient in its own <defs>, so --net does
     nothing here. --net-hi is the ramp's middle stop: one flat colour has to
     stand in for five on the plate, and the magenta is the one people name when
     asked what colour Instagram is. */
  .social__link[data-net='instagram'] {
    --net-hi: #d62976;
  }

  .social__glyph {
    width: 1.125rem;
    height: 1.125rem;
  }

  .social--plate .social__link {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--paper-deep);
    box-shadow: inset 0 0 0 1px var(--paper-rule);
  }

  .social--plate .social__glyph {
    width: 1.3125rem;
    height: 1.3125rem;
  }

  .social--plate {
    gap: 0.5rem;
  }

  /* In the letterhead the icons share a strip with a lockup, four sections, a
     number and a button, so they are drawn tighter than they are in the foot. */
  .social--mark {
    gap: 0.15rem;
  }

  .social--mark .social__link {
    width: 1.75rem;
    height: 1.75rem;
  }

  .social--mark .social__glyph {
    width: 1.0625rem;
    height: 1.0625rem;
  }

  /*
   * Last on purpose. `.social--plate .social__link` sets a resting surface and
   * scores exactly the same specificity as `.social__link:hover`, so anywhere
   * above this point the hover's background and keyline lost to it and only the
   * glyph colour got through. That was survivable while the colour change WAS
   * the hover; now that the glyphs already arrive coloured, --net-hi equals
   * --net for Facebook and LinkedIn and the footer row would have answered the
   * cursor with nothing at all.
   */
  .social__link:hover {
    color: var(--net-hi);
    background: color-mix(in oklab, var(--net-hi) 10%, var(--paper));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--net-hi) 30%, transparent);
  }
</style>
