    border-bottom: max(1px, 0.04em) solid var(--stock-bond-rule-strong);
    font-size: calc(0.3 * var(--u));
    letter-spacing: 0.13em;
    color: var(--stock-bond-quiet);
  }

  .folder__figures {
    display: grid;
    gap: calc(0.26 * var(--u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Ruled, because the line is the promise: somebody is going to write on it. */
  .folder__figures li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    padding-bottom: calc(0.14 * var(--u));
    border-bottom: 1px dotted var(--stock-bond-rule-strong);
    font-size: calc(0.34 * var(--u));
    line-height: 1.2;
  }

  .folder__figures span {
