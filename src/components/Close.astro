  }

  /* The only thing on the label that waits for the month to close. */
  .folder__figures b {
    font-weight: 560;
    opacity: var(--f3);
    translate: 0 calc((1 - var(--e3)) * 0.12 * var(--u));
  }

  /*
   * Across the TOP corner of the form, not the bottom one: the bottom of the
   * folder belongs to the strap, and a stamp lands on the head of a document
   * anyway — that is where a clerk can see it without picking the file up.
   */
  .folder__stamp {
    position: absolute;
    right: calc(-0.62 * var(--u));
    top: calc(-0.62 * var(--u));
    background: color-mix(in oklab, var(--stock-bond) 88%, transparent);
    scale: calc(1 + (1 - var(--e3)) * 0.7);
    opacity: clamp(0, calc((var(--p) - 0.7) / 0.03), 1);
  }

  /* ── the five documents ───────────────────────────────────────────── */

  .stack {
    position: absolute;
    inset: 0;
    z-index: 20;
    /* The hand sinks behind the front panel until only the MASTHEADS show above
       the mouth — not until it is gone. The last thing legible under the lip is
